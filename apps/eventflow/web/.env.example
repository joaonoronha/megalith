# Turso Database Credentials (Edge libSQL)
TURSO_DATABASE_URL=libsql://your-database-name-organization.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# For offline local development, you can use:
# TURSO_DATABASE_URL=file:local.db

# Calendly Webhook Integration
CALENDLY_WEBHOOK_SECRET=your_calendly_webhook_signing_secret

# Base URL for public quote approval links
NEXT_PUBLIC_APP_URL=http://localhost:3000
