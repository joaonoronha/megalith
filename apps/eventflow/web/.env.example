# Turso Database Credentials (Edge libSQL)
TURSO_DATABASE_URL=libsql://your-database-name-organization.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# For offline local development, you can use:
# TURSO_DATABASE_URL=file:local.db

# Base URL for public quote approval links and OAuth redirects
NEXT_PUBLIC_APP_URL=https://cfm-events.vercel.app

# Calendly Integration (Webhooks or OAuth 2.0)
# Webhook Signing Key from Calendly Webhooks
CALENDLY_WEBHOOK_SECRET=your_calendly_webhook_signing_secret

# Optional: Calendly OAuth 2.0 Credentials (if using OAuth app flow)
CALENDLY_CLIENT_ID=your_calendly_client_id
CALENDLY_CLIENT_SECRET=your_calendly_client_secret
