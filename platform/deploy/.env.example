# PostgreSQL Local Development Environment Configuration
# Copy this file to .env for local Docker Compose execution.
# NEVER commit real credentials to Git.

# PostgreSQL Administrator Credentials (Superuser)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# Demo Product Database & Role Credentials
DEMO_DB_NAME=db_demo
DEMO_DB_MIGRATE_USER=role_demo_migrate
DEMO_DB_MIGRATE_PASSWORD=demo_migrate_dev_password
DEMO_DB_APP_USER=role_demo_app
DEMO_DB_APP_PASSWORD=demo_app_dev_password

# Application Database Connection Strings
# Used by demo-migrate service in Compose
DATABASE_MIGRATE_URL=postgresql+psycopg://role_demo_migrate:demo_migrate_dev_password@postgres:5432/db_demo

# Used by demo-api runtime service in Compose
DATABASE_URL=postgresql+psycopg://role_demo_app:demo_app_dev_password@postgres:5432/db_demo
